{
  "name": "parallax-opencode",
  "version": "1.0.1",
  "description": "Verified change loop for OpenCode: preflight gate, bounded project checks with durable receipts, and Horizon, a resumable supervisor for long-running goals",
  "type": "module",
  "main": "./dist/plugin.js",
  "types": "./dist/plugin.d.ts",
  "exports": {
    ".": {
      "types": "./dist/plugin.d.ts",
      "import": "./dist/plugin.js"
    },
    "./verify": {
      "types": "./dist/verify.d.ts",
      "import": "./dist/verify.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "agents",
    "skills",
    "scripts/install.mjs",
    "LICENSE"
  ],
  "bin": {
    "parallax-opencode": "scripts/install.mjs"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "tsc && tsc -p tsconfig.test.json && cd .test-dist && node --test",
    "test:pack": "node scripts/pack-smoke.mjs",
    "test:opencode": "node scripts/opencode-e2e.mjs",
    "check": "npm run typecheck && npm test && npm run build && npm run test:pack && npm run test:opencode",
    "release": "node scripts/publish.mjs",
    "release:dry": "node scripts/publish.mjs --dry-run",
    "prepublishOnly": "npm run check"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "verification",
    "ai-agent"
  ],
  "license": "MIT",
  "author": "Master0fFate",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20",
    "opencode": ">=1.18.35"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Master0fFate/parallax-opencode.git"
  },
  "homepage": "https://github.com/Master0fFate/parallax-opencode#readme",
  "bugs": {
    "url": "https://github.com/Master0fFate/parallax-opencode/issues"
  },
  "dependencies": {
    "@opencode-ai/plugin": "^1.18.35"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "opencode-ai": "1.18.35",
    "typescript": "^5.9.3"
  }
}
